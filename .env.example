# ==============================================================================
# Traffic Prediction System Configuration (.env.example)
# Copy to .env and adjust variable values for your local / production setup
# ==============================================================================

# Hybrid Data Source Mode ('offline' | 'online' | 'auto')
DATA_SOURCE_MODE=offline

# TomTom Flow Segment API Credentials
TOMTOM_API_KEY=
TOMTOM_API_BASE_URL=https://api.tomtom.com
TOMTOM_FLOW_VERSION=4
TOMTOM_FLOW_STYLE=relative
TOMTOM_FLOW_ZOOM=10
TOMTOM_SPEED_UNIT=kmph

# Online Ingestion Settings
ONLINE_REQUEST_TIMEOUT_SECONDS=15
ONLINE_MAX_RETRIES=3
ONLINE_RETRY_DELAY_SECONDS=5
ONLINE_POLL_INTERVAL_SECONDS=1800
ONLINE_REQUEST_BUDGET_PER_DAY=2000

# File Input Paths (Direct Extracted Offline Raw Data Paths)
OFFLINE_RAW_GLOB=data/lab_raw/*.csv
LOCATIONS_FILE=data/locations/data_converted.csv
REFERENCE_PROCESSED_FILE=data/lab_reference/process_data_spark.csv

# Application Environment
TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO

# HDFS Architecture Configuration
HDFS_URI=hdfs://namenode:9000
HDFS_RAW_PATH=/traffic_project/raw
HDFS_PROCESSED_PATH=/traffic_project/processed
HDFS_MODEL_PATH=/traffic_project/models
HDFS_PREDICTION_PATH=/traffic_project/predictions

# Apache Spark Cluster Configuration
SPARK_MASTER=spark://spark-master:7077
SPARK_APP_NAME=TrafficFlowETL
